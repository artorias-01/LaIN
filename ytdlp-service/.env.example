# FastAPI yt-dlp service configuration
YTDLP_SERVICE_HOST=0.0.0.0
YTDLP_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Supabase (only needed if you want to verify JWTs on stream requests)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Search result cache TTL in seconds
CACHE_TTL_SECONDS=300

# Max search results to return (music-filtered)
MAX_SEARCH_RESULTS=10

# Minimum track duration in seconds (filters out Shorts)
MIN_TRACK_DURATION=60
