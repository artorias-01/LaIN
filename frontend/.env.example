# Supabase environment variables (get from supabase.com > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# yt-dlp service URL
# In dev, Vite proxies /ytapi → http://localhost:8000, so leave as /ytapi
# In prod, point to your deployed yt-dlp service URL
VITE_YTDLP_SERVICE_URL=/ytapi
